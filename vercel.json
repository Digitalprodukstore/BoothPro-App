{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/session?route=config"
    },
    {
      "source": "/api/softfile-upload",
      "destination": "/api/session?route=softfile-upload"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
