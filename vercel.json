{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/payment/create",
      "destination": "/api/session?route=payment-create"
    },
    {
      "source": "/api/payment/status",
      "destination": "/api/session?route=payment-status"
    },
    {
      "source": "/api/payment/notification",
      "destination": "/api/session?route=payment-notification"
    },
    {
      "source": "/api/config",
      "destination": "/api/session?route=config"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}